# Copy to .env (git-ignored) for local dev; set the same names in the Vercel
# project settings for deploys. Placeholders only — never commit real values.
# VITE_* values are compiled into the public browser bundle: never put a secret
# in a VITE_* variable. Everything else is read only by the serverless api/.

# ---------------------------------------------------------------- Frontend (Vite)
# Sanity project/dataset the site reads published content from (public, read-only).
VITE_SANITY_PROJECT_ID=your_project_id
# Dataset name (defaults to "production").
VITE_SANITY_DATASET=production
# Sanity API version date (defaults to 2024-01-01).
VITE_SANITY_API_VERSION=2024-01-01
# Canonical site origin, no trailing slash: canonical/og:url tags + absolute og:image
# (also used by studio/scripts/generateSitemap.mjs). Leave empty to skip canonicals.
VITE_SITE_URL=https://www.example.com
# Cloudflare Turnstile PUBLIC site key; empty = widget not rendered.
VITE_TURNSTILE_SITE_KEY=
# WhatsApp number for the SalesBot hand-off, digits only with country code; empty = hidden.
VITE_WHATSAPP_NUMBER=

# ---------------------------------------------------------------- API (api/contact.js)
# Sanity project/dataset leads are written to (falls back to SANITY_STUDIO_* names).
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
# SECRET: Sanity token with write access (Editor). Server-side only.
SANITY_WRITE_TOKEN=your_write_token
# Production site origin allowed to POST /api/contact (CORS), no trailing slash.
# localhost:5173/3000 are only allowed outside production (VERCEL_ENV/NODE_ENV).
ALLOWED_ORIGIN=https://www.example.com
# SECRET: Cloudflare Turnstile secret; empty = verification skipped.
TURNSTILE_SECRET_KEY=
# SECRET: Resend API key for lead notification emails; empty = email skipped (lead still stored).
RESEND_API_KEY=
# Verified sender address for notification emails.
CONTACT_FROM_EMAIL=noreply@example.com
# Where notifications go: sales leads, "Careers" enquiries, and the fallback.
SALES_EMAIL=sales@example.com
TALENT_EMAIL=careers@example.com
DEFAULT_NOTIFY_EMAIL=
# Upstash Redis REST credentials for per-IP rate limiting (token is SECRET); empty = rate limiting skipped.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set automatically by Vercel (production | preview | development) — do not set manually.
# VERCEL_ENV=
