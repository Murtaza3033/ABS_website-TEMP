# Copy to studio/.env (git-ignored) for the scripts in studio/scripts/
# (seed.mjs, uploadAssets.mjs, generateSitemap.mjs). Never commit real values.

# Sanity project + dataset the scripts talk to (required, also for --dry-run).
SANITY_STUDIO_PROJECT_ID=5knwlrie
SANITY_STUDIO_DATASET=production

# Sanity Write Token for seeding content (not needed for --dry-run)
# GET THIS TOKEN:
# 1. Go to: https://www.sanity.io/manage
# 2. Select project: "5knwlrie"
# 3. Go to: API -> Tokens -> Add API Token
# 4. Name: "local-seed-script"
# 5. Permissions: "Editor" (read + write)
# 6. Copy token and paste below

SANITY_WRITE_TOKEN=your_token_here_replace_this
